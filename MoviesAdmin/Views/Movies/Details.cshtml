@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h1>Movie Details</h1>

<div>
    <h4>Movie</h4>
    <hr />

    <div class="row">

        <div class="col-md-4 mb-4 text-center">
            @if (!string.IsNullOrEmpty(Model.PosterImagePath))
            {
                <img src="~/images/@Model.PosterImagePath" alt="Movie Poster" class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto; border: 1px solid #ddd; padding: 4px;" />
            }
            else
            {
                <img src="~/images/egg-placeholder-png.png" alt="No Poster Available" class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto; border: 1px solid #ddd; padding: 4px;" />
            }
        </div>

        <div class="col-md-8">
            <dl class="row">

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Title)
                </dd>

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Synopsis)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Synopsis)
                </dd>

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Genre)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Genre)
                </dd>

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Rating)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Rating)
                </dd>

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Minutes)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Minutes)
                </dd>

                <dt class="col-sm-3 mb-2 fw-bold">
                    @Html.DisplayNameFor(model => model.Releasedate)
                </dt>
                <dd class="col-sm-9 mb-2">
                    @Html.DisplayFor(model => model.Releasedate)
                </dd>

            </dl>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
        Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>
</div>
